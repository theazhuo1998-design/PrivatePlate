# Copy to .env and fill in, then load it into your shell before starting.
# Never commit .env, API keys, or model-server credentials.
#
# The application only accepts an OpenAI-compatible endpoint on loopback.
# Loopback can point to an on-device process or an SSH tunnel; only the former
# keeps model inputs physically on the household device.

# --- Chat model (Agent tool routing) — default port 8000 ---
PRIVATEPLATE_MODEL_ACTIVE=google/gemma-4-12B-it-qat-w4a16-ct
PRIVATEPLATE_VLLM_BASE_URL=http://127.0.0.1:8000/v1
# PRIVATEPLATE_VLLM_API_KEY=
# PRIVATEPLATE_REQUEST_TIMEOUT_MS=120000

# --- Local RAG (embedding retrieval) — dedicated port 8001 ---
# Real RAG path used by tool retrieve_local_knowledge:
#   1) Start chat server on :8000
#   2) Start embedding server on :8001  (bash scripts/rag/serve-bge-small.example.sh)
#   3) npm run rag:check
#   4) export the vars below, then npm run dev:server
PRIVATEPLATE_RAG_MODE=vllm
PRIVATEPLATE_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
PRIVATEPLATE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# PRIVATEPLATE_EMBEDDING_DIMS=512
#
# Offline unit tests / no embedding server:
# PRIVATEPLATE_RAG_OFFLINE=yes

# --- App / database ---
# PRIVATEPLATE_APP_MODE=demo
# PRIVATEPLATE_AGENT_PROVIDER=local_vllm
# PRIVATEPLATE_DATABASE_PATH=./data/privateplate-demo.sqlite
# PRIVATEPLATE_EPHEMERAL_DB=yes
# PORT=8787

# Production mode adds access-token protection. Deployment topology is separate:
# PRIVATEPLATE_APP_MODE=production
# PRIVATEPLATE_ACCESS_TOKEN=
